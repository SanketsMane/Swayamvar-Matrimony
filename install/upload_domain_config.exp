#!/usr/bin/expect -f
set timeout 20

# Upload production.env
spawn scp -o StrictHostKeyChecking=no -P 22 production.env root@91.99.127.245:/var/www/swayamvar/.env
expect {
  "password:" {
    send "!Jn\$J!@0SA87Q5z8AAts\r"
    exp_continue
  }
  eof
}

# Upload nginx config
spawn scp -o StrictHostKeyChecking=no -P 22 swayamvar_nginx root@91.99.127.245:/etc/nginx/sites-available/swayamvar
expect {
  "password:" {
    send "!Jn\$J!@0SA87Q5z8AAts\r"
    exp_continue
  }
  eof
}

# Apply config and restart nginx
spawn ssh -o StrictHostKeyChecking=no -p 22 root@91.99.127.245 "ln -sf /etc/nginx/sites-available/swayamvar /etc/nginx/sites-enabled/swayamvar && nginx -t && systemctl reload nginx && cd /var/www/swayamvar && php artisan optimize:clear && php artisan optimize"
expect {
  "password:" {
    send "!Jn\$J!@0SA87Q5z8AAts\r"
    exp_continue
  }
  eof
}
